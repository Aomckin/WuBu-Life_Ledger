# Local-only by default. Setting this to 0.0.0.0 exposes an unauthenticated app.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TZ=Europe/Berlin

# Local development uses stockroom:local. For a published image, set for example:
# STOCKROOM_IMAGE=timo348/stockroom:1.0.0
# Then run: docker compose pull; docker compose up -d --no-build
# STOCKROOM_VERSION=local

# Used only with: docker compose -f compose.yaml -f compose.ai.yaml up -d
# Keep this value equal to LOCAL_AI_MODEL selected in ../local-ai.
# AI_MODEL=qwen3-vl:8b-instruct
# AI_BASE_URL=http://ollama:11434
# AI_TIMEOUT=180s
# AI_TRANSCRIPTION_URL=http://whisper:8080/inference
# AI_TRANSCRIPTION_LANGUAGE=de
