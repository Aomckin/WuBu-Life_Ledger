{
  "schemas": {
    "DomainLinkInput": {
      "type": "object",
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "ITEM_ACQUISITION",
            "MAINTENANCE",
            "ITEM"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "transaction_id": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "PURCHASE",
            "MAINTENANCE",
            "SALE",
            "REFUND",
            "RETURN"
          ]
        }
      },
      "required": [
        "source_type",
        "source_id",
        "transaction_id",
        "relation"
      ],
      "additionalProperties": false
    },
    "FinanceRefundInput": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "related_transaction_id": {
          "type": "string",
          "maxLength": 200
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "related_transaction_id",
        "amount"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "purchase_event_id"
          ]
        },
        {
          "required": [
            "related_transaction_id"
          ]
        }
      ]
    },
    "ReturnRecord": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "quantity"
      ],
      "additionalProperties": false
    },
    "SaleRecord": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MaintenanceRecord": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "DONE",
            "PLANNED"
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "AcquisitionInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "merchant": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcquisitionLine"
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "AcquisitionLine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "改单保留原商品行 id；新增行不传 id。"
        },
        "item_id": {
          "type": "string",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "商品基础名称，例如无糖可乐；旧的名称加规格输入会自动拆分。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "multipleOf": 0.001,
          "exclusiveMinimum": 0,
          "description": "购买数量，例如 1 瓶的数量为 1；不能用规格容量 2L 替代数量。"
        },
        "unit": {
          "type": "string",
          "maxLength": 20,
          "description": "数量单位，常用：瓶、罐、升、毫升、个、包、盒、袋、箱、支、卷、片、克、千克、件、套、份；允许自定义。包装规格写入 name。例如 name=无糖可乐2L, quantity=1, unit=瓶。"
        },
        "item_type": {
          "enum": [
            "CONSUMABLE",
            "DURABLE",
            "UNTRACKED"
          ],
          "type": "string",
          "description": "DURABLE requires quantity=1, one instance per line; UNTRACKED must omit item_id.",
          "default": "CONSUMABLE"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "location": {
          "type": "string",
          "maxLength": 60
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "brand": {
          "type": "string",
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "serial_number": {
          "type": "string",
          "maxLength": 200
        },
        "warranty_until": {
          "type": "string",
          "format": "date"
        },
        "package_size": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "package_unit": {
          "type": "string",
          "maxLength": 20,
          "description": "包装容量或重量单位，如 L、ml；不决定库存数量。"
        }
      },
      "required": [
        "name",
        "quantity",
        "unit"
      ],
      "additionalProperties": false
    },
    "Category": {
      "type": "string",
      "enum": [
        "pantry",
        "drinks",
        "cleaning",
        "bathroom",
        "laundry",
        "household",
        "health",
        "pets",
        "baby",
        "other"
      ]
    },
    "PurchaseDeletion": {
      "type": "object",
      "properties": {
        "expected_updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "刚读取的购买记录 updated_at；版本不一致返回 409。"
        }
      },
      "required": [
        "expected_updated_at"
      ],
      "additionalProperties": false
    },
    "AcquisitionAmendment": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "merchant": {
          "type": "string"
        },
        "external_id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcquisitionLine"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "expected_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "items",
        "expected_updated_at"
      ],
      "additionalProperties": false
    },
    "FinancialSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_commit_threshold": {
          "type": "number",
          "minimum": 0.95,
          "maximum": 1
        }
      },
      "required": [
        "auto_commit_threshold"
      ]
    },
    "SemanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "attachment_ref": {
          "type": "string"
        },
        "matched_transaction_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ]
    },
    "MerchantRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "merchant_raw": {
          "type": "string"
        },
        "merchant_normalized": {
          "type": "string"
        },
        "annotation": {
          "$ref": "#/$defs/TransactionAnnotation"
        },
        "user_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "merchant_raw",
        "annotation",
        "user_confirmed"
      ]
    },
    "TransactionAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "nullable": true
        },
        "expense_nature": {
          "type": "string",
          "nullable": true
        },
        "meal_type": {
          "type": "string",
          "nullable": true
        },
        "item_name": {
          "type": "string",
          "nullable": true
        },
        "item_description": {
          "type": "string",
          "nullable": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "annotated_by": {
          "type": "string"
        },
        "annotation_status": {
          "type": "string",
          "enum": [
            "AUTO_ANNOTATED",
            "REVIEW_NEEDED",
            "CONFIRMED"
          ]
        }
      },
      "required": [
        "annotated_by",
        "annotation_status",
        "confidence"
      ]
    },
    "RawFinancialInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_code": {
          "type": "string"
        },
        "description_raw": {
          "type": "string"
        },
        "payment_method_raw": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "review_reason": {
          "type": "string"
        },
        "time_precision": {
          "type": "string",
          "enum": [
            "",
            "DAY",
            "SECOND"
          ]
        },
        "related_transaction_id": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": [
            "WECHAT",
            "ALIPAY",
            "BANK",
            "UNIONPAY",
            "CASH",
            "OTHER"
          ]
        },
        "capture_source": {
          "type": "string",
          "enum": [
            "CSV_IMPORT",
            "MANUAL",
            "AGENT",
            "SYSTEM"
          ]
        },
        "external_id": {
          "type": "string"
        },
        "captured_at": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "nullable": true
        },
        "direction": {
          "type": "string"
        },
        "merchant_raw": {
          "type": "string"
        },
        "payment_channel": {
          "type": "string"
        },
        "funding_hint": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "raw_title": {
          "type": "string"
        },
        "raw_text": {
          "type": "string"
        },
        "raw_payload": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "capture_source",
        "raw_text"
      ]
    },
    "FinancialReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "nullable": true
        },
        "occurred_at": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "description": "EXPENSE, INCOME, REFUND, or TRANSFER_IN/TRANSFER_OUT for MATCH only; transfer legs are never created independently."
        },
        "related_transaction_id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "MATCH",
            "CREATE_NEW",
            "IGNORE"
          ]
        },
        "transaction_id": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "merchant": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "reason"
      ]
    },
    "NamedDiscardInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "NamedFinishInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "NamedOpenInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "NamedAdjustInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "delta": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000,
          "multipleOf": 0.001
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "multipleOf": 0.001
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "delta"
          ],
          "not": {
            "required": [
              "quantity"
            ]
          }
        },
        {
          "required": [
            "quantity"
          ],
          "not": {
            "required": [
              "delta"
            ]
          }
        }
      ],
      "required": [
        "name"
      ]
    },
    "NamedConsumeInput": {
