{
  "schemas": {
    "PurchaseInput": {
      "type": "object",
      "properties": {
        "merchant": {
          "type": "string",
          "maxLength": 200
        },
        "purchased_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "currency": {
          "type": "string",
          "enum": [
            "CNY"
          ],
          "default": "CNY"
        },
        "payment_method": {
          "type": "string",
          "maxLength": 100
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "discount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "extra_fee": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/PurchaseLine"
          }
        },
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        }
      },
      "required": [
        "total_amount",
        "items"
      ],
      "additionalProperties": false
    },
    "PurchaseLine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "商品基础名称，例如无糖可乐；旧的名称加规格输入会自动拆分。"
        },
        "item_id": {
          "type": "string",
          "maxLength": 100
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "multipleOf": 0.001,
          "exclusiveMinimum": 0,
          "description": "购买数量，例如 1 瓶的数量为 1；不能用规格容量 2L 替代数量。"
        },
        "unit": {
          "type": "string",
          "maxLength": 20,
          "description": "数量单位，常用：瓶、罐、升、毫升、个、包、盒、袋、箱、支、卷、片、克、千克、件、套、份；允许自定义。包装规格写入 name。例如 name=无糖可乐2L, quantity=1, unit=瓶。"
        },
        "unit_price": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "subtotal": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "item_type": {
          "enum": [
            "CONSUMABLE",
            "DURABLE",
            "UNTRACKED"
          ],
          "type": "string",
          "description": "DURABLE requires quantity=1, one instance per line; UNTRACKED must omit item_id.",
          "default": "CONSUMABLE"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "location": {
          "type": "string",
          "maxLength": 60
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "brand": {
          "type": "string",
          "maxLength": 200
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "serial_number": {
          "type": "string",
          "maxLength": 200
        },
        "warranty_until": {
          "type": "string",
          "format": "date"
        },
        "id": {
          "type": "string",
          "description": "改单保留原商品行 id；新增行不传 id。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        },
        "package_size": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "package_unit": {
          "type": "string",
          "maxLength": 20,
          "description": "包装容量或重量单位，如 L、ml；不决定库存数量。"
        },
        "quantity_added": {
          "type": "number",
          "readOnly": true
        },
        "inventory_after": {
          "type": "number",
          "readOnly": true,
          "description": "写入完成时的库存快照，幂等重放返回原快照。"
        }
      },
      "required": [
        "name",
        "quantity",
        "unit",
        "unit_price",
        "subtotal"
      ],
      "additionalProperties": false
    },
    "PurchaseAmendment": {
      "type": "object",
      "properties": {
        "merchant": {
          "type": "string",
          "maxLength": 200
        },
        "purchased_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "currency": {
          "type": "string",
          "enum": [
            "CNY"
          ],
          "default": "CNY"
        },
        "payment_method": {
          "type": "string",
          "maxLength": 100
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "discount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "extra_fee": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/PurchaseLine"
          }
        },
        "expected_updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "刚读取的购买记录 updated_at；版本不一致返回 409。"
        },
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        }
      },
      "required": [
        "total_amount",
        "items",
        "expected_updated_at",
        "source",
        "external_id"
      ],
      "additionalProperties": false,
      "description": "整笔替换购买。保留 source、external_id 和原商品行 id。费用与库存差额在同一事务内更新；既有消耗保留。换单位只允许没有其他购买或库存变化的独立物品。已关联商品行不能改变 item_type 或 item_id；移除旧行并新增时，仍受库存与耐用品约束。"
    },
    "PurchaseDeletion": {
      "type": "object",
      "properties": {
        "expected_updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "刚读取的购买记录 updated_at；版本不一致返回 409。"
        }
      },
      "required": [
        "expected_updated_at"
      ],
      "additionalProperties": false
    },
    "Category": {
      "type": "string",
      "enum": [
        "pantry",
        "drinks",
        "cleaning",
        "bathroom",
        "laundry",
        "household",
        "health",
        "pets",
        "baby",
        "other"
      ]
    },
    "InventoryAction": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false
    },
    "ConsumeInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "multipleOf": 0.001,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "required": [
        "quantity"
      ],
      "additionalProperties": false
    },
    "InventoryAdjustment": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "delta": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000,
          "multipleOf": 0.001
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "multipleOf": 0.001
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "按名称操作时的商品名或别名。"
        },
        "spec": {
          "type": "string",
          "maxLength": 100,
          "description": "每包装规格，例如 2L；与购买数量和库存单位分别存储。"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "delta"
          ],
          "not": {
            "required": [
              "quantity"
            ]
          }
        },
        {
          "required": [
            "quantity"
          ],
          "not": {
            "required": [
              "delta"
            ]
          }
        }
      ]
    },
    "MaintenanceInput": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "receipt",
            "system"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "status": {
          "type": "string",
          "enum": [
            "DONE",
            "PLANNED"
          ],
          "default": "DONE",
          "description": "PLANNED requires cost=0; DONE cost>0 posts MoneyTransaction and account balance atomically."
        },
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "AliasInput": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        }
      },
      "required": [
        "alias"
      ],
      "additionalProperties": false
    },
    "DurablePatch": {
      "type": "object",
      "properties": {
        "brand": {
          "type": "string",
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "maxLength": 2000
        },
        "serial_number": {
          "type": "string",
          "maxLength": 2000
        },
        "warranty_until": {
          "type": "string",
          "description": "YYYY-MM-DD or empty"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "STORED",
            "LOST",
            "SOLD",
            "RETIRED",
            "ARCHIVED",
            "DISCARDED"
          ],
          "description": "ARCHIVED input maps to STORED; DISCARDED to RETIRED. SOLD posts income atomically; ended lifecycle cannot be restored."
        },
        "sold_at": {
          "type": "string",
          "description": "RFC3339 timestamp or empty; required for SOLD"
        },
        "sold_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan (元), at most two decimals; persisted as integer cents."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "ReturnItem": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "maxLength": 200
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.001
        }
      },
      "required": [
        "item_id",
        "quantity"
      ],
      "additionalProperties": false
    },
    "AccountInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": [
            "WALLET",
            "BANK",
            "CASH",
            "CAMPUS_CARD",
            "CREDIT_CARD",
            "OTHER"
          ],
          "default": "OTHER"
        },
        "currency": {
          "type": "string",
          "enum": [
            "CNY"
          ]
        },
        "initial_balance": {
          "type": "number",
          "minimum": -10000000000,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "Signed net balance or delta in CNY yuan."
        },
        "credit_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "MoneySettings": {
      "type": "object",
      "properties": {
        "default_payment_account": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "default_payment_account"
      ],
      "additionalProperties": false
    },
    "IncomeInput": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false
    },
    "ExpenseInput": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "merchant": {
          "type": "string",
          "maxLength": 200
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false
    },
    "TransferInput": {
      "type": "object",
      "properties": {
        "from_account": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "to_account": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "from_account",
        "to_account",
        "amount"
      ],
      "additionalProperties": false
    },
    "RefundInput": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "CNY yuan, persisted as integer cents."
        },
        "purchase_event_id": {
          "type": "string",
          "maxLength": 200
        },
        "related_transaction_id": {
          "type": "string",
          "maxLength": 200
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "return_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReturnItem"
          }
        }
      },
      "required": [
        "amount"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "purchase_event_id"
          ]
        },
        {
          "required": [
            "related_transaction_id"
          ]
        }
      ]
    },
    "BalanceAdjustmentInput": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "maxLength": 200,
          "description": "Account ID or exact name; omitted uses default payment account, then unknown."
        },
        "actual_balance": {
          "type": "number",
          "minimum": -10000000000,
          "maximum": 10000000000,
          "multipleOf": 0.01,
          "description": "Signed net balance or delta in CNY yuan."
        },
        "occurred_at": {
          "type": "string",
          "description": "RFC3339 with timezone; empty/omitted defaults to now."
        },
        "external_id": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "agent",
            "import",
            "system",
            "receipt"
          ],
          "default": "manual"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "actual_balance"
      ],
      "additionalProperties": false
    },
    "DurableActionInput": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
