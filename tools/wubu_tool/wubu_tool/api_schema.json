          "type": "number",
          "minimum": 0,
          "maximum": 10000000000,
          "multipleOf": 0.01
        },
        "runway_horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3660
        }
      },
      "required": [
        "safety_buffer",
        "runway_horizon_days"
      ]
    },
    "PlannedAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        }
      }
