# Pin Ollama so every amd64 host starts the same runtime release.
OLLAMA_IMAGE=ollama/ollama:0.14.3

# Separate local speech-to-text runtime. CPU image is default; NVIDIA overlay swaps it for CUDA.
WHISPER_IMAGE=ghcr.io/ggerganov/whisper.cpp:main
WHISPER_CUDA_IMAGE=ghcr.io/ggerganov/whisper.cpp:main-cuda
WHISPER_MODEL=base
WHISPER_LANGUAGE=de
WHISPER_THREADS=4

# Keep the HTTP API private to this Docker host.
BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434

# Strong, multimodal default. Choose a preset in profiles/ before the first model pull.
LOCAL_AI_MODEL=qwen3-vl:8b-instruct
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=15m
